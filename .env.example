# Copy to .env and adjust. Never commit the real .env file.
POSTGRES_DB=shopscale
POSTGRES_USER=shopscale
POSTGRES_PASSWORD=change-me

# AI reports: mock | gemini | openai
AI_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=

# Public port of the web container
WEB_PORT=8088
JWT_SECRET=change-this-secret-in-production-0123456789
