# Copy to .env and adjust. Never commit the real .env file.

# ---- Identity. All provisional: set them when the brand and the domain are decided. ----
BRAND_NAME=Game Store
BRAND_DOMAIN=gamestore.co
BRAND_SUPPORT_EMAIL=hola@gamestore.co
BRAND_DATA_EMAIL=datos@gamestore.co
# Only ever set this once: clients match on the error type URIs.
BRAND_PROBLEM_BASE_URI=https://gamestore.co/problems
APP_BASE_URL=http://localhost:8088

POSTGRES_DB=gamestore
POSTGRES_USER=gamestore
POSTGRES_PASSWORD=change-me

# AI reports: mock | gemini | openai
AI_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=

# Public port of the web container
WEB_PORT=8088
# Session cookie. In production leave these unset: the defaults are __Host-SID and Secure.
SESSION_COOKIE_NAME=SID
SESSION_COOKIE_SECURE=false

# Encrypts the second factor secrets. Generate a long random value per environment.
APP_SECRET_KEY=dev-only-key-change-me

# ---- Provider accounts. Empty until the accounts exist; each feature stays off without them. ----
# Payments (phase 3)
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=
# Electronic invoicing (phase 3)
FACTUS_CLIENT_ID=
FACTUS_CLIENT_SECRET=
# Shipping (phase 4)
ENVIA_API_KEY=
# Email and WhatsApp (phase 6)
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
