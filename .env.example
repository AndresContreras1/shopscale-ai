# Copy to .env and adjust. Never commit the real .env file.
POSTGRES_DB=gamestore
POSTGRES_USER=gamestore
POSTGRES_PASSWORD=change-me

# AI reports: mock | gemini | openai
AI_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=

# Public port of the web container
WEB_PORT=8088
# Session cookie. In production leave these unset: the defaults are __Host-SID and Secure.
SESSION_COOKIE_NAME=SID
SESSION_COOKIE_SECURE=false

# Encrypts the second factor secrets. Generate a long random value per environment.
APP_SECRET_KEY=dev-only-key-change-me
